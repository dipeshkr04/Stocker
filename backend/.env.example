NODE_ENV=development
PORT=3000

# PostgreSQL or Supabase connection string.
# Leave unset when USE_DATABASE=false.
DATABASE_URL=postgresql://username:password@localhost:5432/stock_forecasting
USE_DATABASE=false
DATABASE_POOL_MAX=10

FRONTEND_ORIGIN=http://localhost:5173
FORECAST_SERVICE_URL=http://127.0.0.1:8000

# Select "fixture", "alpha_vantage", or "fmp".
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=replace_me
FMP_API_KEY=replace_me

REQUEST_TIMEOUT_MS=10000
